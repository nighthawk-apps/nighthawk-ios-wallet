"nighthawk.settingsTab.torNetwork.socksDescriptionEmbedded" = "Dirección de loopback en la que escucha Arti integrado (por defecto, 127.0.0.1:9050). DarkIRC integrado usa este proxy para las semillas P2P .onion.";
