"nighthawk.settingsTab.torNetwork.walletNetworkTitle" = "Red de la cartera";
"nighthawk.settingsTab.torNetwork.walletNetworkSubtitle" = "Se usa para la sincronización con lightwalletd y la difusión de transacciones. Cambiar este ajuste vuelve a conectar la cartera.";
"nighthawk.settingsTab.torNetwork.nymStatus" = "Nym: %@";
"nighthawk.settingsTab.torNetwork.nymTitle" = "Mixnet de Nym (recomendada)";
"nighthawk.settingsTab.torNetwork.nymSubtitle" = "Mezcla los paquetes en cinco saltos. El chat usa las semillas de la red clara a través de la mixnet. No puede llegar a direcciones .onion.";
"nighthawk.settingsTab.torNetwork.torTitle" = "Tor";
"nighthawk.settingsTab.torNetwork.torSubtitle" = "Enrutamiento onion mediante Arti integrado o el punto de conexión SOCKS de abajo.";
"nighthawk.settingsTab.torNetwork.directTitle" = "En directo";
"nighthawk.settingsTab.torNetwork.directSubtitle" = "Se conecta directamente al servidor. El servidor ve tu dirección IP.";
"nighthawk.settingsTab.torNetwork.builtInTorTitle" = "Tor integrado (Arti)";
"nighthawk.settingsTab.torNetwork.builtInTorSubtitle" = "Ejecuta Arti (Tor en Rust) dentro de la aplicación y expone una escucha SOCKS en loopback. Es independiente de una aplicación externa de Tor o SOCKS que configures más abajo.";
"nighthawk.settingsTab.torNetwork.useBuiltInArti" = "Usar Arti integrado";
"nighthawk.settingsTab.torNetwork.enableTorHint" = "Activa más arriba el enrutamiento por Tor de toda la aplicación para usar Arti integrado.";
